<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Medyo.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/icon_medyo_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Medyo</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

    <style name="Theme.Medyo" parent="android:Theme.Material.NoActionBar">
        <!-- Allow the navigation bar to be transparent/translucent -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

</resources>