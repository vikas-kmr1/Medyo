<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Medyo.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_medyo_splash</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item  name="windowSplashScreenBackground">@color/white</item>
        <item name="postSplashScreenTheme">@style/Theme.Medyo</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

    <style  name="Theme.Medyo"  parent="android:Theme.Material.NoActionBar">
        <!-- Allow the navigation bar to be transparent/translucent -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

</resources>